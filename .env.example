# LLM mode: replay (default, offline), live (records to data/llm_cache), mock (tests)
INCIDENTIQ_LLM=replay

# live mode: any OpenAI-compatible endpoint (Gemini, Groq, Ollama, ...)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# seconds to wait between live calls (free tier: 15 requests/minute)
LLM_MIN_INTERVAL_S=4
# where recorded replies are read from and written to (default: data/llm_cache)
# LLM_CACHE_DIR=

# Postgres + pgvector (matches docker-compose.yml)
DATABASE_URL=postgresql://incidentiq:incidentiq@localhost:5432/incidentiq

# Embeddings: local sentence-transformers model. Never mix embedders in one database.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

MAX_STEPS=8
